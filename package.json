{
  "name": "@elitan/velo",
  "displayName": "Velo",
  "cliName": "velo",
  "containerPrefix": "velo",
  "version": "1.0.0",
  "description": "Instant PostgreSQL branching with ZFS snapshots",
  "author": "Johan Eliasson <johan@eliasson.me> (https://github.com/elitan)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elitan/velo.git"
  },
  "homepage": "https://github.com/elitan/velo#readme",
  "bugs": {
    "url": "https://github.com/elitan/velo/issues"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "database",
    "branching",
    "zfs",
    "snapshot",
    "docker",
    "development",
    "testing",
    "pitr",
    "backup",
    "clone"
  ],
  "module": "src/index.ts",
  "type": "module",
  "bin": {
    "velo": "./dist/velo"
  },
  "files": [
    "dist/velo",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "os": [
    "linux"
  ],
  "scripts": {
    "test": "./scripts/test.sh",
    "test:control": "bun test src/server/control-plane.test.ts",
    "test:watch": "sudo NODE_ENV=test $(which bun) test --watch",
    "build": "bun build --compile --minify --sourcemap src/index.ts --outfile dist/velo",
    "dev": "bun run src/index.ts",
    "web": "bun --bun vite dev --host 0.0.0.0 --port 3000",
    "web:build": "bun --bun vite build",
    "web:start": "bun src/server/web-runtime.ts",
    "remote:dev": "scripts/remote-dev.sh",
    "remote:sync": "scripts/remote-sync.sh",
    "remote:sync:once": "scripts/remote-sync.sh --once",
    "deploy:dev": "scripts/deploy-dev.sh",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:generate": "bun run db:migrate && kysely-codegen --dialect bun-sqlite --url ${VELO_DB:-$HOME/.velo/velo.sqlite} --out-file src/db/generated.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run build",
    "release": "./scripts/release.sh patch",
    "release:minor": "./scripts/release.sh minor",
    "release:major": "./scripts/release.sh major"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dockerode": "^3.3.44",
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "kysely-codegen": "^0.20.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-router": "^1.169.0",
    "@tanstack/react-start": "^1.167.53",
    "@tanstack/router-plugin": "^1.167.30",
    "@trpc/client": "^11.17.0",
    "@trpc/react-query": "^11.17.0",
    "@trpc/server": "^11.17.0",
    "@vitejs/plugin-react": "^6.0.1",
    "better-auth": "^1.6.9",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "cli-table3": "^0.6.5",
    "clsx": "^2.1.1",
    "commander": "^14.0.1",
    "date-fns": "^4.1.0",
    "dockerode": "^4.0.9",
    "kysely": "^0.28.16",
    "lucide-react": "^1.14.0",
    "ora": "^9.0.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.10",
    "zod": "^4.4.1"
  }
}
