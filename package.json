{
  "name": "@elitan/velo",
  "displayName": "Velo",
  "containerPrefix": "velo",
  "version": "1.0.0",
  "description": "Web-first PostgreSQL branching with ZFS snapshots",
  "author": "Johan Eliasson <johan@eliasson.me> (https://github.com/elitan)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elitan/velo.git"
  },
  "homepage": "https://github.com/elitan/velo#readme",
  "bugs": {
    "url": "https://github.com/elitan/velo/issues"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "database",
    "branching",
    "zfs",
    "snapshot",
    "docker",
    "development",
    "testing",
    "pitr",
    "backup",
    "clone"
  ],
  "type": "module",
  "imports": {
    "#api/*": "./src/api/*",
    "#config/*": "./src/config/*",
    "#db/*": "./src/db/*",
    "#errors": "./src/errors/index.ts",
    "#lib/*": "./src/lib/*",
    "#managers/*": "./src/managers/*",
    "#server/*": "./src/server/*",
    "#utils/*": "./src/utils/*",
    "#web/*": "./src/web/*"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "os": [
    "linux"
  ],
  "scripts": {
    "test": "bun test src/server/control-plane.test.ts src/managers/docker.test.ts",
    "build": "bun run web:build",
    "dev": "bun run web",
    "web": "bun --bun vite dev --host 0.0.0.0 --port 3000",
    "web:build": "bun --bun vite build",
    "web:start": "bun src/server/web-runtime.ts",
    "local:up": "scripts/local-dev.sh up",
    "local:dev": "scripts/local-dev.sh dev",
    "local:down": "scripts/local-dev.sh down",
    "local:reset": "scripts/local-dev.sh reset",
    "local:status": "scripts/local-dev.sh status",
    "remote:dev": "scripts/remote-dev.sh",
    "remote:sync": "scripts/remote-sync.sh",
    "remote:sync:once": "scripts/remote-sync.sh --once",
    "deploy": "scripts/deploy-hetzner.sh",
    "deploy:hetzner": "scripts/deploy-hetzner.sh",
    "deploy:dev": "scripts/deploy-dev.sh",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:generate": "bun run db:migrate && kysely-codegen --camel-case --dialect bun-sqlite --url ${VELO_DB:-$HOME/.velo/velo.sqlite} --out-file src/db/generated.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/dockerode": "^3.3.44",
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "kysely-codegen": "^0.20.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@orpc/client": "^1.14.0",
    "@orpc/server": "^1.14.0",
    "@orpc/tanstack-query": "^1.14.0",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/react-query": "^5.100.6",
    "@tanstack/react-router": "^1.169.0",
    "@tanstack/react-start": "^1.167.53",
    "@tanstack/router-plugin": "^1.167.30",
    "@vitejs/plugin-react": "^6.0.1",
    "better-auth": "^1.6.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dockerode": "^4.0.9",
    "kysely": "^0.28.16",
    "lucide-react": "^1.14.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.0.10",
    "zod": "^4.4.1"
  }
}
